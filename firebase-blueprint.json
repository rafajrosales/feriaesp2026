{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Única cuenta administradora autorizada (rafajrosales@gmail.com) para cambios administrativos en Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "TutorLegal": {
      "title": "TutorLegal",
      "description": "Datos del padre, madre o tutor legal del estudiante.",
      "type": "object",
      "properties": {
        "nombre_tutor": { "type": "string", "minLength": 1, "maxLength": 150 },
        "parentesco": { "type": "string", "enum": ["Padre", "Madre", "Tutor Legal"] },
        "correo_tutor": { "type": "string", "minLength": 3, "maxLength": 150 },
        "telefono_tutor": { "type": "string", "minLength": 1, "maxLength": 30 },
        "verificado": { "type": "boolean" },
        "fecha_verificacion": { "type": "string", "maxLength": 64 },
        "firma_digital": { "type": "string", "maxLength": 100000 },
        "token_verificacion": { "type": "string", "maxLength": 128 }
      },
      "required": ["nombre_tutor", "parentesco", "correo_tutor", "telefono_tutor", "verificado"]
    },
    "Estudiante": {
      "title": "Estudiante",
      "description": "Registro de aspirante o alumno de primer semestre del CETis No. 7.",
      "type": "object",
      "properties": {
        "num_control": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nombre_completo": { "type": "string", "minLength": 2, "maxLength": 150 },
        "grupo": { "type": "string", "minLength": 1, "maxLength": 20 },
        "turno": { "type": "string", "enum": ["MATUTINO"] },
        "correo_institucional": { "type": "string", "minLength": 3, "maxLength": 150 },
        "curp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "avatar_url": { "type": "string", "maxLength": 500 },
        "telefono_alumno": { "type": "string", "maxLength": 30 },
        "tutor": { "$ref": "#/entities/TutorLegal" },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "num_control",
        "nombre_completo",
        "grupo",
        "turno",
        "correo_institucional",
        "curp",
        "tutor",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "CurpRegistry": {
      "title": "CurpRegistry",
      "description": "Índice normalizado sin PII para garantizar unicidad global de CURP en Firestore.",
      "type": "object",
      "properties": {
        "curp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "num_control": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["curp", "num_control", "ownerUid", "createdAt", "updatedAt"]
    },
    "EvaluacionVocacional": {
      "title": "EvaluacionVocacional",
      "description": "Resultado normalizado y sin redundancias del Test Oficial de Orientación Vocacional de 40 reactivos.",
      "type": "object",
      "properties": {
        "num_control": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version_test": { "type": "string", "enum": ["40_REACTIVOS_2026", "8_REACTIVOS_LEGACY"] },
        "total_reactivos": { "type": "number" },
        "desglose_partes": { "type": "object" },
        "respuestas": { "type": "object" },
        "especialidades_empatadas": { "type": "array" },
        "carrera_sugerida": { "type": "string", "enum": ["programacion", "comercio", "rrhh", "cosmetologia"] },
        "segunda_opcion": { "type": "string", "enum": ["programacion", "comercio", "rrhh", "cosmetologia"] },
        "analisis_pedagogico": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "fecha_evaluacion": { "type": "string", "minLength": 4, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "num_control",
        "ownerUid",
        "version_test",
        "total_reactivos",
        "desglose_partes",
        "respuestas",
        "especialidades_empatadas",
        "carrera_sugerida",
        "analisis_pedagogico",
        "fecha_evaluacion",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProgresoVirtual": {
      "title": "ProgresoVirtual",
      "description": "Avance integral del alumno (0% a 100%) en el test vocacional (20%) y las 4 especialidades técnicas (80%).",
      "type": "object",
      "properties": {
        "num_control": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "test_vocacional_completado": { "type": "boolean" },
        "progreso_especialidades": { "type": "object" },
        "porcentaje_virtual": { "type": "number" },
        "promedio_cuestionarios": { "type": "number" },
        "clave_unica_token": { "type": "string", "maxLength": 128 },
        "estatus_fase_virtual": { "type": "string", "enum": ["PENDIENTE", "EN_PROCESO", "COMPLETADO"] },
        "fecha_termino": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "num_control",
        "ownerUid",
        "test_vocacional_completado",
        "progreso_especialidades",
        "porcentaje_virtual",
        "promedio_cuestionarios",
        "clave_unica_token",
        "estatus_fase_virtual",
        "createdAt",
        "updatedAt"
      ]
    },
    "DocenteAutorizado": {
      "title": "DocenteAutorizado",
      "description": "Padrón de docentes y directivos autorizados del CETis No. 7.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nombre_completo": { "type": "string", "minLength": 2, "maxLength": 150 },
        "rfc": { "type": "string", "minLength": 10, "maxLength": 20 },
        "correo_institucional": { "type": "string", "minLength": 3, "maxLength": 150 },
        "academia": { "type": "string", "enum": ["programacion", "comercio", "rrhh", "cosmetologia", "general"] },
        "rol": {
          "type": "string",
          "enum": ["Profesor Titular", "Jefe de Academia", "Tutor Escolar", "Subdirector"]
        },
        "nivel_acceso": { "type": "string", "enum": ["editor", "lector"] },
        "clave_acceso": { "type": "string", "minLength": 4, "maxLength": 64 },
        "estatus_autorizacion": { "type": "string", "enum": ["AUTORIZADO", "PENDIENTE", "REVOCADO"] },
        "fecha_alta": { "type": "string", "maxLength": 64 },
        "registrado_por": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nombre_completo",
        "rfc",
        "correo_institucional",
        "academia",
        "rol",
        "nivel_acceso",
        "clave_acceso",
        "estatus_autorizacion",
        "fecha_alta",
        "createdAt",
        "updatedAt"
      ]
    },
    "DocenteAcceso": {
      "title": "DocenteAcceso",
      "description": "Índice normalizado por correo electrónico para validar acceso de docentes autorizados al módulo de Dirección Académica.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "docente_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nombre_completo": { "type": "string", "minLength": 2, "maxLength": 150 },
        "academia": { "type": "string", "enum": ["programacion", "comercio", "rrhh", "cosmetologia", "general"] },
        "rol": {
          "type": "string",
          "enum": ["Profesor Titular", "Jefe de Academia", "Tutor Escolar", "Subdirector"]
        },
        "nivel_acceso": { "type": "string", "enum": ["editor", "lector"] },
        "clave_acceso": { "type": "string", "minLength": 4, "maxLength": 64 },
        "estatus_autorizacion": { "type": "string", "enum": ["AUTORIZADO", "PENDIENTE", "REVOCADO"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "email",
        "docente_id",
        "nombre_completo",
        "academia",
        "rol",
        "nivel_acceso",
        "clave_acceso",
        "estatus_autorizacion",
        "createdAt",
        "updatedAt"
      ]
    },
    "FichaAcademiaReq": {
      "title": "FichaAcademiaReq",
      "description": "Fuente única de verdad para ficha técnica, multimedia y banco de reactivos de cada academia.",
      "type": "object",
      "properties": {
        "especialidad_id": { "type": "string", "enum": ["programacion", "comercio", "rrhh", "cosmetologia"] },
        "nombre_especialidad": { "type": "string", "minLength": 2, "maxLength": 200 },
        "presidente_academia": { "type": "string", "minLength": 2, "maxLength": 150 },
        "integrantes_academia": { "type": "array" },
        "fecha_entrega": { "type": "string", "maxLength": 64 },
        "resumen_ejecutivo": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "recursos_multimedia": { "type": "object" },
        "banco_reactivos": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "especialidad_id",
        "nombre_especialidad",
        "presidente_academia",
        "integrantes_academia",
        "fecha_entrega",
        "resumen_ejecutivo",
        "recursos_multimedia",
        "banco_reactivos",
        "createdAt",
        "updatedAt"
      ]
    },
    "OficioCircular": {
      "title": "OficioCircular",
      "description": "Oficio circular oficial de Dirección Académica para academias y tutores.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clave_oficio": { "type": "string", "minLength": 2, "maxLength": 100 },
        "asunto": { "type": "string", "minLength": 2, "maxLength": 300 },
        "lugar_fecha": { "type": "string", "minLength": 2, "maxLength": 150 },
        "destinatarios": { "type": "string", "minLength": 2, "maxLength": 300 },
        "cuerpo": { "type": "array" },
        "firmante_cargo": { "type": "string", "minLength": 2, "maxLength": 150 },
        "firmante_nombre": { "type": "string", "minLength": 2, "maxLength": 150 },
        "sello_oficial": { "type": "string", "minLength": 2, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "clave_oficio",
        "asunto",
        "lugar_fecha",
        "destinatarios",
        "cuerpo",
        "firmante_cargo",
        "firmante_nombre",
        "sello_oficial",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccesoGoogle": {
      "title": "AccesoGoogle",
      "description": "Bitácora de cuentas Google que se han autenticado en la plataforma (visible exclusivamente para el administrador).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "nombre_google": { "type": "string", "minLength": 1, "maxLength": 150 },
        "foto_url": { "type": "string", "maxLength": 500 },
        "es_admin": { "type": "boolean" },
        "primer_acceso": { "type": "string", "minLength": 4, "maxLength": 64 },
        "ultimo_acceso": { "type": "string", "minLength": 4, "maxLength": 64 },
        "total_accesos": { "type": "number" },
        "ultimo_origen": { "type": "string", "minLength": 1, "maxLength": 250 },
        "historial_reciente": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "nombre_google",
        "es_admin",
        "primer_acceso",
        "ultimo_acceso",
        "total_accesos",
        "ultimo_origen",
        "historial_reciente",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Registro reservado exclusivamente para la cuenta administradora única rafajrosales@gmail.com."
    },
    "/accesos_google/{userId}": {
      "schema": { "$ref": "#/entities/AccesoGoogle" },
      "description": "Registro en línea de usuarios autenticados con Google en la aplicación (lectura global solo para rafajrosales@gmail.com)."
    },
    "/estudiantes/{numControl}": {
      "schema": { "$ref": "#/entities/Estudiante" },
      "description": "Padrón de alumnos (1°A a 1°H, turno matutino) con datos escolares, CURP y autorización del tutor legal."
    },
    "/curp_registry/{curp}": {
      "schema": { "$ref": "#/entities/CurpRegistry" },
      "description": "Índice único global de CURP para prevenir duplicados entre AI Studio y Vercel."
    },
    "/evaluaciones/{numControl}": {
      "schema": { "$ref": "#/entities/EvaluacionVocacional" },
      "description": "Resultados normalizados del Test Oficial de Orientación Vocacional de 40 reactivos."
    },
    "/progresos/{numControl}": {
      "schema": { "$ref": "#/entities/ProgresoVirtual" },
      "description": "Seguimiento del avance de orientación vocacional (100%) y generación del token QR."
    },
    "/docentes/{docenteId}": {
      "schema": { "$ref": "#/entities/DocenteAutorizado" },
      "description": "Padrón confidencial de docentes autorizados administrado por rafajrosales@gmail.com."
    },
    "/docente_accesos/{emailId}": {
      "schema": { "$ref": "#/entities/DocenteAcceso" },
      "description": "Índice autenticado por correo electrónico para habilitar la entrada de docentes autorizados a Dirección Académica en modo consulta."
    },
    "/fichas_academia/{especialidadId}": {
      "schema": { "$ref": "#/entities/FichaAcademiaReq" },
      "description": "Fuente única de contenido multimedia, datos de academia y banco de reactivos por especialidad."
    },
    "/configuracion/{configId}": {
      "schema": { "$ref": "#/entities/OficioCircular" },
      "description": "Configuración institucional única del plantel (oficio circular oficial)."
    }
  }
}
